{
  "name": "crm-marmeria",
  "version": "1.5.0",
  "description": "Sistema CRM professionale per la gestione di marmerie e lavorazioni in pietra",
  "author": "CRM Marmeria Team",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --configLoader native",
    "build": "vite build --configLoader native",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview",
    "server:install": "npm install --prefix server",
    "server": "npm --prefix server start",
    "server:dev": "npm --prefix server run dev",
    "server:test": "npm --prefix server test",
    "dev:full": "concurrently \"npm run server:dev\" \"npm run dev\"",
    "test": "vitest --configLoader native",
    "test:ui": "vitest --ui"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.18.1",
    "chart.js": "^4.5.0",
    "idb": "^8.0.3",
    "lucide-react": "^0.322.0",
    "react": "^18.3.0",
    "react-chartjs-2": "^5.3.0",
    "react-dom": "^18.3.0",
    "react-hot-toast": "^2.5.2",
    "react-redux": "^9.2.0",
    "recharts": "^2.6.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^24.0.8",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.1",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.8.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "js-yaml": "4.3.0",
    "lodash": "4.18.1",
    "path-to-regexp": "0.1.13"
  },
  "allowScripts": {
    "esbuild@0.25.5": true
  }
}
